{
  "name": "managed-ops",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply managed-ops-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply managed-ops-db --remote",
    "deploy": "wrangler pages deploy public",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^5.6.2",
    "wrangler": "^4.0.0"
  }
}
